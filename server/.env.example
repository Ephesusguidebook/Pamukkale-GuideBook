# Server port
PORT=4000

# MySQL database — create one from Hostinger's hPanel under Databases > MySQL
# Databases (or your own MySQL/MariaDB server for local development), then
# copy its host/user/password/name here. The server creates its tables
# automatically on first run and, if server/data.json exists from an older
# version of this project, imports it automatically too — no manual steps.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT signing secret for admin login — MUST be changed in production
JWT_SECRET=change-this-to-a-long-random-string

# First admin account (only created if the database is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Public site URL — used to build absolute links in sitemap.xml
SITE_URL=https://pamukkaleguidebook.com

# SMTP settings — optional. If set, a notification email is sent to the
# address configured in Admin > Settings whenever the contact form is
# submitted. Leave blank to disable email notifications (the contact form
# still works either way; messages always show up under Admin > Messages).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# "From" address used for outgoing notification emails
SMTP_FROM=
